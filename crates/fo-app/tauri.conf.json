{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileOdyssey",
  "version": "0.1.0",
  "identifier": "io.github.shamsularefin707.fileodyssey",
  "build": {
    "frontendDist": "../fo-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "trunk serve --config ../fo-ui/Trunk.toml",
    "beforeBuildCommand": "trunk build --release --config ../fo-ui/Trunk.toml"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FileOdyssey",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Offline file and image toolkit",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
